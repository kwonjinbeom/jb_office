# workspace/.env 로 복사해서 쓴다. 이 파일(.env)은 git 에 올라가지 않는다.
# 로컬 PC 개발에서는 .env 가 없어도 된다 (전부 기본값 = dev 역할).

# ---- 서버(PythonAnywhere) 예시 ----
WORKSERVER_ROLE=server
DJANGO_SECRET_KEY=여기에-긴-무작위-문자열
DJANGO_ALLOWED_HOSTS=<아이디>.pythonanywhere.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://<아이디>.pythonanywhere.com

# DB 를 저장소 밖에 둔다. git pull 과 완전히 분리된다.
DATABASE_PATH=/home/<아이디>/data/db.sqlite3

# 홈의 '서버 코드 갱신' 버튼: git pull 뒤 이 파일을 touch 하면 PythonAnywhere 가 앱을 reload 한다.
DEPLOY_RELOAD_TOUCH_FILE=/var/www/<아이디>_pythonanywhere_com_wsgi.py

# GitHub 에 push 하면 자동 반영 (웹훅). GitHub 저장소 Settings → Webhooks 의 Secret 과 같은 값.
# 비우면 자동 반영은 꺼지고 홈의 '서버 코드 갱신' 버튼만 동작한다.
DEPLOY_WEBHOOK_SECRET=여기에-긴-무작위-문자열-2

# 아래는 server 역할의 기본값이라 생략 가능
# DJANGO_DEBUG=false
# REQUIRE_LOGIN=true
# AUTOSYNC_ENABLED=false
# DEPLOY_PULL_ENABLED=true
